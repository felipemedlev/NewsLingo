# Copy to .env.local and fill in locally. Never commit .env.local.

# HebrewTime dictionary import (see README "HebrewTime dictionary").
HEBREWTIME_SUPABASE_URL=
HEBREWTIME_SUPABASE_SERVICE_ROLE_KEY=
DICTIONARY_REUSE_APPROVED=

# News import (see README "Real news imports"). Without OPENAI_API_KEY,
# imports fall back to original headlines with no translation.
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5-mini
NEWS_IMPORT_LIMIT=7
